{
  "name": "@endge/raph",
  "private": false,
  "version": "3.0.3",
  "description": "Reactive application pipeline & router (Raph) - core library",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/raph.js",
  "module": "./dist/raph.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/raph.js",
      "require": "./dist/raph.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "build": "vue-tsc --noCheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:derived": "vitest run src/test/units/derived --exclude **/*.memory.spec.ts",
    "test:derived:memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.memory.config.ts",
    "bench": "vitest bench --run",
    "bench:derived": "vitest bench --run src/test/units/benchmarks/bench.derived-*.bench.ts",
    "bench:derived:stress": "RAPH_DERIVED_STRESS=1 vitest bench --run src/test/units/benchmarks/bench.derived-*.bench.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "rimraf": "^6.0.1",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
