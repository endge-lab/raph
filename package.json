{
  "name": "@endge/raph",
  "type": "module",
  "version": "3.1.0",
  "private": false,
  "description": "Reactive application pipeline & router (Raph) - core library",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/raph.js",
      "require": "./dist/raph.cjs"
    }
  },
  "main": "./dist/raph.js",
  "module": "./dist/raph.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:derived": "vitest run src/test/units/derived --exclude **/*.memory.spec.ts",
    "test:derived:memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.memory.config.ts src/test/units/derived",
    "test:memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.memory.config.ts",
    "bench": "vitest bench --run",
    "bench:derived": "vitest bench --run src/test/units/benchmarks/bench.derived-*.bench.ts",
    "bench:derived:stress": "RAPH_DERIVED_STRESS=1 vitest bench --run src/test/units/benchmarks/bench.derived-*.bench.ts",
    "lint-check": "eslint . --cache",
    "lint-fix": "eslint . --fix --cache"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
